# ObsidianConscierge 環境変数設定ファイル
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env

# ============================================================================
# GitHub設定（TargetObsidianVault同期用）
# ============================================================================

# GitHubリポジトリ名（owner/repo形式、推奨）
# 例: GITHUB_REPO_NAME=username/my-vault
GITHUB_REPO_NAME=

# GitHubリポジトリURL（GITHUB_REPO_NAME未設定時に使用）
# 例: GITHUB_REPO_URL=https://github.com/username/my-vault.git
GITHUB_REPO_URL=

# GitHubトークン（必須）
# Personal Access Token (classic) を生成してください
# スコープ: repo (read/write access)
# 例: GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# ============================================================================
# Obsidian設定
# ============================================================================

# Obsidian Vault名（必須）
# Obsidianアプリで表示されるVault名
# 例: OBSIDIAN_VAULT_NAME=MyVault
OBSIDIAN_VAULT_NAME=

# Obsidian Vaultのローカルパス（デフォルト: ./TargetObsidianVault）
# Gitリポジトリをクローンする先のディレクトリ
# 例: OBSIDIAN_VAULT_PATH=./TargetObsidianVault
OBSIDIAN_VAULT_PATH=./TargetObsidianVault

# ============================================================================
# Ollama設定（ローカルLLMサーバー）
# ============================================================================

# OllamaサーバーのベースURL（デフォルト: http://localhost:11434）
# 例: OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama LLMモデル名（テキスト生成用、デフォルト: llama3）
# 使用可能なモデル: llama3, mistral, llama3.1 など
# 例: OLLAMA_LLM_MODEL=gpt-oss:20b
OLLAMA_LLM_MODEL=gpt-oss:20b

# 注意: Embeddingはsentence-transformersを使用するため、
# OLLAMA_EMBEDDING_MODELは不要です（既存実装を継続使用）

# ============================================================================
# ベクトルDB設定
# ============================================================================

# ChromaDBのデータ保存パス（デフォルト: ./data/chroma_db）
# 例: CHROMA_DB_PATH=./data/chroma_db
CHROMA_DB_PATH=./data/chroma_db

# ============================================================================
# 分析設定
# ============================================================================

# 重複検知の閾値（0.0-1.0、デフォルト: 0.8）
# 類似度がこの値を超える記事ペアを重複候補として報告
# 例: DUPLICATE_THRESHOLD=0.8
DUPLICATE_THRESHOLD=0.8

# クラスター数（デフォルト: auto）
# auto: 自動決定、または数値を指定
# 例: CLUSTER_COUNT=auto
CLUSTER_COUNT=auto

# タグ自動生成のON/OFF（デフォルト: true）
# true: LLMでタグを自動生成
# false: 既存タグのみ使用
# 例: ENABLE_AUTO_TAGGING=true
ENABLE_AUTO_TAGGING=true

# アトミック運用のパイプライン用フォルダ（カテゴリ判定から除外）
# デフォルト: 00_Raw,01_Summary,02_Atomic,03_MOC
# 例: PIPELINE_FOLDERS=00_Raw,01_Summary,02_Atomic,03_MOC
PIPELINE_FOLDERS=00_Raw,01_Summary,02_Atomic,03_MOC

# ============================================================================
# ログ設定
# ============================================================================

# ログレベル（デフォルト: INFO）
# 使用可能な値: DEBUG, INFO, WARNING, ERROR
# 例: LOG_LEVEL=INFO
LOG_LEVEL=INFO

# ログファイルのパス（デフォルト: ./logs/obsidian_conscierge.log）
# 例: LOG_FILE=./logs/obsidian_conscierge.log
LOG_FILE=./logs/obsidian_conscierge.log

# ============================================================================
# Web UI設定
# ============================================================================

# Webサーバーのホスト（デフォルト: 0.0.0.0）
# 0.0.0.0: すべてのインターフェースでリッスン
# 127.0.0.1: ローカルホストのみ
# 例: WEB_HOST=0.0.0.0
WEB_HOST=0.0.0.0

# Webサーバーのポート（デフォルト: 8000）
# 例: WEB_PORT=8000
WEB_PORT=8000

# ============================================================================
# Git同期設定
# ============================================================================

# Git自動同期の有効/無効（デフォルト: true）
# true: 自動同期を有効化
# false: 自動同期を無効化
# 例: GIT_AUTO_SYNC_ENABLED=true
GIT_AUTO_SYNC_ENABLED=true

# Git同期間隔（分、デフォルト: 30）
# systemdタイマーで使用
# 例: GIT_SYNC_INTERVAL_MINUTES=30
GIT_SYNC_INTERVAL_MINUTES=30

# Git同期時の自動コミット・プッシュ（デフォルト: false）
# true: pull後に安全な変更のみ自動コミット・プッシュ（追跡済み変更 + 新規 .md）
# false: 自動コミット・プッシュしない
# 例: GIT_AUTO_PUSH_ENABLED=false
GIT_AUTO_PUSH_ENABLED=false

# 自動コミット時に許可する新規ファイル拡張子（カンマ区切り、デフォルト: .md）
# 例: GIT_AUTO_PUSH_ALLOWED_EXTENSIONS=.md,.canvas
GIT_AUTO_PUSH_ALLOWED_EXTENSIONS=.md

# ============================================================================
# ドキュメント自動編集設定
# ============================================================================

# 自動編集対象外のフォルダリスト（カンマ区切り）
# これらのフォルダ内のファイルは、類似リンク・タグの自動挿入対象外になります
# デフォルト: 01DIARY,02TEMPLATES,06MOC,10KANBAN,11MEDIA,Excalidraw,Maybe,Omnivore,model_cache,PythonScripts,github,.chroma_db,.claude,.devcontainer,.smtcmp_json_db,.smtcmp_vector_db
EXCLUDED_FOLDERS=01DIARY,02TEMPLATES,06MOC,10KANBAN,11MEDIA,Excalidraw,Maybe,Omnivore,model_cache,PythonScripts,github,.chroma_db,.claude,.devcontainer,.smtcmp_json_db,.smtcmp_vector_db

# 類似リンク自動挿入の有効/無効（デフォルト: true）
# true: 類似ドキュメントへのリンクを自動挿入
# false: リンク自動挿入を無効化
# 例: ENABLE_AUTO_LINK_INSERT=true
ENABLE_AUTO_LINK_INSERT=true

# タグ自動挿入の有効/無効（デフォルト: true）
# true: 関連タグを自動挿入
# false: タグ自動挿入を無効化
# 例: ENABLE_AUTO_TAG_INSERT=true
ENABLE_AUTO_TAG_INSERT=true

# リンク挿入の最小類似度（0.0-1.0、デフォルト: 0.5）
# この値以上の類似度を持つドキュメントのみリンクを挿入
# 例: MIN_SIMILARITY_FOR_LINK=0.5
MIN_SIMILARITY_FOR_LINK=0.5

# 挿入する類似リンクの最大数（1-10、デフォルト: 3）
# 例: MAX_SIMILAR_LINKS=3
MAX_SIMILAR_LINKS=3
