# ================================
# ObsidianConscierge Configuration
# ================================

# -------------------------------------
# GitHub Settings (for TargetObsidianVault synchronization)
# -------------------------------------
GITHUB_REPO_NAME=yourusername/your-vault-repo
GITHUB_REPO_URL=https://github.com/yourusername/your-vault-repo.git
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_BRANCH=main

# -------------------------------------
# Obsidian Settings
# -------------------------------------
OBSIDIAN_VAULT_NAME=YourVaultName
OBSIDIAN_VAULT_PATH=./TargetObsidianVault

# -------------------------------------
# Ollama Settings (Local LLM Server)
# -------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
# Other options: mistral, llama3.1, llama2, etc.

# Ollama API Timeout (seconds)
OLLAMA_TIMEOUT=60

# Note: Embeddings use sentence-transformers (distiluse-base-multilingual-cased-v2)
# OLLAMA_EMBEDDING_MODEL is not needed

# -------------------------------------
# Vector Database Settings (ChromaDB)
# -------------------------------------
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=articles

# ChromaDB Settings
CHROMA_ANONYMIZED_TELEMETRY=false

# -------------------------------------
# Analysis Settings
# -------------------------------------
# Duplicate detection threshold (0.0-1.0)
DUPLICATE_THRESHOLD=0.8

# Cluster count (auto or integer)
CLUSTER_COUNT=auto

# Enable automatic tagging
ENABLE_AUTO_TAGGING=true

# Maximum tags per article
MAX_TAGS_PER_ARTICLE=10

# TF-IDF minimum document frequency
TFIDF_MIN_DF=5

# TF-IDF maximum document frequency (ratio)
TFIDF_MAX_DF=0.8

# Minimum TF-IDF score for tag inclusion
TFIDF_MIN_SCORE=0.1

# -------------------------------------
# Git Synchronization Settings
# -------------------------------------
# Enable automatic Git synchronization
GIT_AUTO_SYNC_ENABLED=true

# Sync interval in minutes
GIT_SYNC_INTERVAL_MINUTES=30

# Auto-commit changes
GIT_AUTO_COMMIT=true

# Commit message template
GIT_COMMIT_MESSAGE=Auto-sync: {date}

# -------------------------------------
# Web API Settings (FastAPI)
# -------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000

# API base path (e.g., /api)
API_BASE_PATH=/api

# Enable CORS (for development)
ENABLE_CORS=true

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------------------------
# Logging Settings
# -------------------------------------
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=./logs/obsidian_conscierge.log

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log rotation (max bytes)
LOG_MAX_BYTES=10485760  # 10MB

# Log backup count
LOG_BACKUP_COUNT=5

# -------------------------------------
# Report Settings
# -------------------------------------
# Daily report generation time (HH:MM)
DAILY_REPORT_TIME=06:00

# Number of random articles to pick
RANDOM_PICKUP_COUNT=3

# Report output format (markdown or html)
REPORT_OUTPUT_FORMAT=markdown

# Report output directory
REPORT_OUTPUT_DIR=./reports/daily

# -------------------------------------
# Performance Settings
# -------------------------------------
# Batch size for vector generation
BATCH_SIZE=100

# Maximum concurrent jobs
MAX_CONCURRENT_JOBS=4

# Cache size for embeddings
CACHE_SIZE=1000

# -------------------------------------
# Feature Flags
# -------------------------------------
# Enable daily report generation
ENABLE_DAILY_REPORT=true

# Enable knowledge map generation (Phase 3)
ENABLE_KNOWLEDGE_MAP=false

# Enable MOC candidate extraction
ENABLE_MOC_CANDIDATES=true

# Enable duplicate detection
ENABLE_DUPLICATE_DETECTION=true

# Enable clustering analysis (Phase 3)
ENABLE_CLUSTERING=false

# -------------------------------------
# Development Settings
# -------------------------------------
# Enable debug mode
DEBUG=false

# Reload on code changes (development only)
RELOAD=false

# -------------------------------------
# Testing Settings (optional)
# -------------------------------------
# Test database path
TEST_CHROMA_DB_PATH=./data/test_chroma_db

# Test vault path
TEST_VAULT_PATH=./tests/fixtures/test_vault
