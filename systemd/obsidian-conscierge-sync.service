[Unit]
Description=ObsidianConscierge Git Sync Service
After=network.target

[Service]
Type=oneshot
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/ObsidianConscierge
EnvironmentFile=/home/YOUR_USER/ObsidianConscierge/.env
# Git同期スクリプトを実行（shスクリプトを使用）
ExecStart=/home/YOUR_USER/ObsidianConscierge/scripts/git_sync.sh
# またはPythonスクリプトを使用する場合:
# ExecStart=/home/YOUR_USER/.local/bin/uv run python /home/YOUR_USER/ObsidianConscierge/scripts/git_sync.py --use-sh-script
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

