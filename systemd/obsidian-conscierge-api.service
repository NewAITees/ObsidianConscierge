[Unit]
Description=ObsidianConscierge API
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/ObsidianConscierge
EnvironmentFile=/home/YOUR_USER/ObsidianConscierge/.env
ExecStart=/home/YOUR_USER/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
