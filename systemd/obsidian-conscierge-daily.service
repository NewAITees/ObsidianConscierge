[Unit]
Description=ObsidianConscierge Daily Report
After=network.target

[Service]
Type=oneshot
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/ObsidianConscierge
EnvironmentFile=/home/YOUR_USER/ObsidianConscierge/.env
ExecStart=/home/YOUR_USER/.local/bin/uv run python scripts/daily_report.py

[Install]
WantedBy=multi-user.target
